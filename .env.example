# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your_gemini_api_key_here"

# Revenue Intelligence Engine — frontend keys (VITE_ prefix required for Vite)
VITE_GEMINI_API_KEY="your_gemini_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"

# SUPABASE: configure your Supabase project here for data persistence.
# Example:
# VITE_SUPABASE_URL="https://your-project.supabase.co"
# VITE_SUPABASE_ANON_KEY="sb_publishable_xxxx"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# AXIS PUBLIC API — chaves de autenticação para o endpoint /api/v1/leads
# Múltiplas chaves separadas por vírgula. Envie no header: x-api-key: <chave>
# Chave principal (uso interno/admin):
AXIS_API_KEY_MAIN="your_axis_api_key_main_here"
# Chave do formulário público (landing page → SDR):
AXIS_API_KEY_FORM="your_axis_api_key_form_here"
# Todas as chaves válidas (separadas por vírgula):
AXIS_API_KEYS="your_axis_api_key_main_here,your_axis_api_key_form_here"

# AXIS_CORS_ORIGIN — origem permitida para chamadas externas (ex: https://minhapagina.com)
# Use * para permitir qualquer origem (apenas em desenvolvimento)
AXIS_FORM_TENANT_ID="<uuid-do-tenant-no-supabase>"
AXIS_FORM_CLIENT_ID="<id-do-cliente-na-tabela-clientes>"
AXIS_CORS_ORIGIN="*"